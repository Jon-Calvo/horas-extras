'use server'

import { revalidatePath } from 'next/cache'
import { createClient } from '@/lib/supabase/server'
import { solicitudesRpc } from '@/lib/supabase/rpc'

// Todas devuelven { error } en vez de tirar, para que el componente cliente
// pueda mostrar el mensaje sin try/catch. El mensaje de error ya viene
// legible desde el RPC de Postgres (raise exception '...').

//async function ejecutar(accion: (rpc: ReturnType<typeof solicitudesRpc>) => Promise<{ error: { message: string } | null }>, solicitudId: string) {
//  const supabase = await createClient()
//  const { error } = await accion(solicitudesRpc(supabase))
//  revalidatePath(`/solicitudes/${solicitudId}`)
//  revalidatePath('/solicitudes')
//  return { error: error?.message }
//}
async function ejecutar(
  accion: (rpc: ReturnType<typeof solicitudesRpc>) => PromiseLike<any>,
  solicitudId: string
) {
  const supabase = await createClient()

  const { error } = await accion(solicitudesRpc(supabase))

  revalidatePath(`/solicitudes/${solicitudId}`)
  revalidatePath('/solicitudes')

  return { error: error?.message }
}

//export const agregarEmpleadoAction = (solicitudId: string, empleadoId: string) =>
//  ejecutar((rpc) => rpc.agregarEmpleado(solicitudId, empleadoId), solicitudId)
export async function agregarEmpleadoAction( 
  solicitudId: string, 
  empleadoId: string 
) { 
  return await ejecutar( 
    (rpc) => rpc.agregarEmpleado(solicitudId, empleadoId), 
    solicitudId 
  ) 
}

